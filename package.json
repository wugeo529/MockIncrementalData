{
  "name": "mock-incremental-data",
  "version": "0.1.0",
  "description": "可视化增量数据源模拟器：GPS、IP会话、目标档案",
  "main": "desktop/main.cjs",
  "author": "wugeo529",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/wugeo529/MockIncrementalData.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:engine": "python scripts/build-engine.py",
    "dist:win": "electron-builder --win zip nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64 --publish never",
    "dist:mac": "electron-builder --mac zip dmg --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.wugeo529.mockincrementaldata",
    "productName": "MockIncrementalData",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/engine/mock-source-engine",
        "to": "engine"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "MockIncrementalData-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MockIncrementalData-${version}-Setup-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
